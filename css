*{margin:0;padding:0;box-sizing:border-box;font-family:Arial,sans-serif}
body{background:#f4f8fb;color:#222}
.container{width:min(1100px,92%);margin:auto;padding:50px 0}
header{background:#003b73;color:#fff;position:sticky;top:0}
.nav{display:flex;justify-content:space-between;align-items:center;padding:18px 0}
nav a{color:#fff;text-decoration:none;margin-left:18px}
.hero{height:75vh;background:linear-gradient(rgba(0,0,0,.45),rgba(0,0,0,.45)),url('https://images.unsplash.com/photo-1507525428034-b723cf961d3e?auto=format&fit=crop&w=1400&q=80') center/cover;display:flex;align-items:center;justify-content:center;text-align:center;color:#fff}
.overlay h1{font-size:3rem}
.btn{display:inline-block;background:#ff9800;color:#fff;padding:12px 24px;border-radius:6px;text-decoration:none;margin-top:20px}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:20px;margin-top:20px}
.card{background:#fff;padding:25px;border-radius:10px;box-shadow:0 4px 12px rgba(0,0,0,.1);text-align:center}
button{margin-top:12px;padding:10px 18px;border:none;background:#0077b6;color:#fff;border-radius:6px}
footer{background:#003b73;color:#fff;text-align:center;padding:25px;margin-top:40px}
